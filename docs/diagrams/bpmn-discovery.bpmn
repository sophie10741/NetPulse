<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_discovery" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_discovery">
    <bpmn:participant id="Participant_NetPulse" name="NetPulse: обнаружение сети" processRef="Process_discovery" />
    <bpmn:participant id="Participant_Devices" name="Сетевые устройства (Linux, SSH)" />
    <bpmn:messageFlow id="Msg_1" name="SSH: hostname, ip a, arp -an" sourceRef="Task_Scan" targetRef="Participant_Devices" />
    <bpmn:messageFlow id="Msg_2" name="вывод команд" sourceRef="Participant_Devices" targetRef="Task_Scan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_discovery" isExecutable="false">
    <bpmn:laneSet id="LaneSet_discovery">
      <bpmn:lane id="Lane_Admin" name="Администратор">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="NetPulse">
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Show</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Нужна схема сети" />
    <bpmn:userTask id="Task_Input" name="Указать IP стартового устройства и ключевые слова">
      <bpmn:documentation>FR-10, US-10</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Ввод корректен?">
      <bpmn:documentation>FR-10</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_InputError" name="Показать ошибку ввода">
      <bpmn:documentation>FR-10</bpmn:documentation>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Scan" name="Обойти сеть по SSH и сохранить результат">
      <bpmn:documentation>FR-11, FR-12</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Found" name="Устройства найдены?">
      <bpmn:documentation>FR-11</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reason" name="Показать причину пустого результата">
      <bpmn:documentation>FR-15 (запланировано)</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="End_Fail" name="Схема не получена" />
    <bpmn:task id="Task_Show" name="Показать схему и таблицу устройств">
      <bpmn:documentation>FR-17, FR-18</bpmn:documentation>
    </bpmn:task>
    <bpmn:userTask id="Task_View" name="Просмотреть схему и список устройств">
      <bpmn:documentation>US-10, US-13</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OK" name="Сеть отображена" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Input" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_3" name="да" sourceRef="Gw_Valid" targetRef="Task_Scan" />
    <bpmn:sequenceFlow id="Flow_4" name="нет" sourceRef="Gw_Valid" targetRef="Task_InputError" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_InputError" targetRef="Task_Input" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Scan" targetRef="Gw_Found" />
    <bpmn:sequenceFlow id="Flow_7" name="да" sourceRef="Gw_Found" targetRef="Task_Show" />
    <bpmn:sequenceFlow id="Flow_8" name="нет" sourceRef="Gw_Found" targetRef="Task_Reason" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Reason" targetRef="End_Fail" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Show" targetRef="Task_View" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_View" targetRef="End_OK" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_discovery">
    <bpmndi:BPMNPlane id="BPMNPlane_discovery" bpmnElement="Collaboration_discovery">
      <bpmndi:BPMNShape id="Participant_NetPulse_di" bpmnElement="Participant_NetPulse" isHorizontal="true"><dc:Bounds x="60" y="40" width="1220" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true"><dc:Bounds x="90" y="40" width="1190" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="90" y="200" width="1190" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Devices_di" bpmnElement="Participant_Devices" isHorizontal="true"><dc:Bounds x="60" y="520" width="1220" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="172.0" y="102.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="130" y="142" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Input_di" bpmnElement="Task_Input"><dc:Bounds x="255.0" y="85.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Valid_di" bpmnElement="Gw_Valid" isMarkerVisible="true"><dc:Bounds x="435.0" y="265.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="372" y="248" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InputError_di" bpmnElement="Task_InputError"><dc:Bounds x="405.0" y="365.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_di" bpmnElement="Task_Scan"><dc:Bounds x="555.0" y="255.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Found_di" bpmnElement="Gw_Found" isMarkerVisible="true"><dc:Bounds x="735.0" y="265.0" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="700" y="242" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reason_di" bpmnElement="Task_Reason" bioc:stroke="#e65100" bioc:fill="#fff3e0"><dc:Bounds x="705.0" y="365.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fail_di" bpmnElement="End_Fail"><dc:Bounds x="892.0" y="382.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="850" y="422" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Show_di" bpmnElement="Task_Show"><dc:Bounds x="855.0" y="255.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_View_di" bpmnElement="Task_View"><dc:Bounds x="1005.0" y="85.0" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OK_di" bpmnElement="End_OK"><dc:Bounds x="1172.0" y="102.0" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1130" y="142" width="120" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="208" y="120" /><di:waypoint x="255" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="365" y="120" /><di:waypoint x="460" y="120" /><di:waypoint x="460" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="485" y="290" /><di:waypoint x="555" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="460" y="315" /><di:waypoint x="460" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="405" y="400" /><di:waypoint x="310" y="400" /><di:waypoint x="310" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="665" y="290" /><di:waypoint x="735" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="785" y="290" /><di:waypoint x="855" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="760" y="315" /><di:waypoint x="760" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="815" y="400" /><di:waypoint x="892" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="965" y="290" /><di:waypoint x="1060" y="290" /><di:waypoint x="1060" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1115" y="120" /><di:waypoint x="1172" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_1_di" bpmnElement="Msg_1"><di:waypoint x="595" y="325" /><di:waypoint x="595" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_2_di" bpmnElement="Msg_2"><di:waypoint x="625" y="520" /><di:waypoint x="625" y="325" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
